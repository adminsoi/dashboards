# Copy to .env and fill in. Never commit .env.
#
# In production these are supplied as stack environment variables — either from
# a .env beside docker-compose.yml, or entered in Portainer's stack editor.

# --- Where the app is reachable -------------------------------------------
# Must match the Entra redirect URI exactly (that URI is this + /auth/callback).
PUBLIC_BASE_URL=https://dashboard.soiaviation.com

# --- The private backend (runs on the MCP connector host) -----------------
# Holds every downstream API credential. This app holds none of them.
#
# The MCP stack is on a DIFFERENT EC2 instance, so this is reached over the VPC
# private network — the MCP host's PRIVATE IP, never its public one, and never
# over the internet. Requires BACKEND_BIND + a security-group rule on that
# host; see PORTAINER.md.
BACKEND_BASE_URL=http://10.0.1.23:8080
# The value from the MCP host's own .env. Must match exactly — the backend
# compares a hash of it. Your local .env is an unfilled template.
BACKEND_SERVICE_TOKEN=
BACKEND_TIMEOUT_MS=15000

# Where the container's port 3000 is published on this host. Loopback by
# default so the app is never directly internet-facing; TLS terminates in front
# of it. Change only deliberately.
DASHBOARD_BIND=127.0.0.1:3000

# --- Microsoft Entra SSO ---------------------------------------------------
# A DEDICATED app registration for this app — not the MCP app ids. See SETUP.md.
ENTRA_TENANT_ID=57ded119-c5e8-4224-b902-3d9240e1dfb7
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# HMAC key for session cookies, 32+ chars. Rotating it signs everyone out.
#   generate with: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_SECONDS=28800

# --- Department access control --------------------------------------------
# Leave false until every group id below is filled in. Enforcement fails
# closed: no group match means no access.
DEPT_ACCESS_ENFORCE=false
# Entra security group OBJECT IDs (not names). Comma-separate to allow several.
DEPT_GROUP_GOVERNMENT=
DEPT_GROUP_PROCUREMENT=
DEPT_GROUP_PURCHASING=
DEPT_GROUP_FINANCE=
DEPT_GROUP_HR=
DEPT_GROUP_IT=
DEPT_GROUP_OPERATIONS=
# Groups that may see every department (e.g. leadership, IT administrators).
DEPT_GROUP_ALL=

# --- Data ------------------------------------------------------------------
# NAICS code driving the Government opportunity feed. 336413 = aircraft parts.
GOVERNMENT_NAICS=336413

# --- Local development only ------------------------------------------------
# "none" skips SSO entirely and is refused when NODE_ENV=production.
# AUTH_MODE=none
# PORT=3000
# Extra services for the IT dashboard to probe, as "Label=host:port,...".
# The private backend is always probed. The connector containers live on the
# other host and are NOT probed unless listed here with reachable addresses —
# otherwise the dashboard would report them down when they are fine.
# SERVICE_PROBES=
