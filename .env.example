# Copy to .env and fill in. Never commit .env.
#
# In production these are supplied as stack environment variables — either a
# .env beside docker-compose.yml, or entered in Portainer's stack editor.
#
# Only the four Entra values below are required. Everything else has a working
# default, and the app runs fully standalone without any of them.

# --- Required: Microsoft Entra SSO -----------------------------------------
# A DEDICATED app registration for this app. See SETUP.md.
ENTRA_TENANT_ID=57ded119-c5e8-4224-b902-3d9240e1dfb7
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# HMAC key for session cookies, 32+ chars. Rotating it signs everyone out.
#   generate with: openssl rand -base64 48
SESSION_SECRET=

# --- Where the app is reachable --------------------------------------------
# The Entra redirect URI is this value + /auth/callback, and must match exactly.
PUBLIC_BASE_URL=https://dashboard.soiaviation.com

# How long before a user re-authenticates against Entra (default 8h).
SESSION_TTL_SECONDS=28800

# Where the container's port 3000 is published on the host. Loopback by
# default so the app is never directly internet-facing; TLS terminates in
# front of it. Change only deliberately.
DASHBOARD_BIND=127.0.0.1:3000

# --- Optional: department access control -----------------------------------
# Leave false until every group id below is filled in. Enforcement fails
# closed: no group match means no access.
DEPT_ACCESS_ENFORCE=false
# Entra security group OBJECT IDs (not names). Comma-separate to allow several.
DEPT_GROUP_GOVERNMENT=
DEPT_GROUP_PROCUREMENT=
DEPT_GROUP_PURCHASING=
DEPT_GROUP_FINANCE=
DEPT_GROUP_HR=
DEPT_GROUP_IT=
DEPT_GROUP_OPERATIONS=
# Groups that may see every dashboard (e.g. leadership, IT administrators).
DEPT_GROUP_ALL=

# --- Optional: a data source -----------------------------------------------
# Unset by default, which is a fully supported configuration: the app runs
# standalone and every data tile reports that nothing is connected. Point this
# at an HTTP backend later to light those tiles up — nothing else changes.
BACKEND_BASE_URL=
BACKEND_SERVICE_TOKEN=
BACKEND_TIMEOUT_MS=15000
# Extra services for the IT dashboard to probe, as "Label=host:port,...".
SERVICE_PROBES=
# NAICS code for the Government feed, if a data source is connected.
GOVERNMENT_NAICS=336413

# --- Local development only ------------------------------------------------
# "none" skips SSO entirely and is refused when NODE_ENV=production.
# AUTH_MODE=none
# PORT=3000
