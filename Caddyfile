# HTTPS for an internal-only host.
#
# Certificates are obtained with the DNS-01 challenge, so this box never needs
# a public IP or an open port 80 — Caddy proves domain ownership by writing a
# temporary TXT record via the DNS provider's API, then renews the same way.
#
# GODADDY_API_TOKEN is "key:secret" from https://developer.godaddy.com/keys
# (use a Production key, not OTE).
#
# To use Route 53 instead — worth doing if the zone is ever moved to AWS, since
# the instance's IAM role can be used and there is no API key to store — swap
# the tls block for:
#     tls {
#         dns route53
#     }
# and give the instance role route53:ChangeResourceRecordSets and
# route53:GetChange on the hosted zone.

{$DASHBOARD_HOST:dashboard.soiaviation.com} {
	tls {
		dns godaddy {env.GODADDY_API_TOKEN}
	}

	reverse_proxy dashboard:3000

	# Belt and braces: the app sets these too, but if Caddy is ever put in
	# front of something else here, they still apply.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
